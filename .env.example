# Copy this file to .env. Never distribute the populated .env file.
APP_ENV=development
APP_VERSION=2.0.0

# ── Alerts ───────────────────────────────────────────────────────────────────
# Where alerts are delivered. Alertmanager talks to Telegram's servers, not to
# this application, so reusing the assistant's own token still works while the
# bot process is down, which is exactly when the first alert fires. Leave the
# token empty to do that; set it only to alert through a separate bot. The chat
# id is required: it is the conversation that receives the alerts.
# Apply changes with scripts/install_alertmanager_config.sh, as root.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── Backups — BUCKET: Backblaze B2 ──────────────────────────────────────────
# BACKUP_REMOTE is required: a copy that lives only on the VPS does not survive
# losing the VPS, so scripts/backup.sh refuses to run without it. Use an rclone
# remote or an scp target (user@host:/srv/backups). Production uses b2crypt:,
# an rclone crypt remote over the B2 bucket, so the provider only ever holds
# ciphertext (docs/private/runbook-backup-cifrado.md). Install the nightly job
# with scripts/install_backup_cron.sh.
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=14

# ── Cache and queue (Redis) ──────────────────────────────────────────────────
CACHE_ANSWER_TTL=86400
CACHE_EMBED_TTL=604800
CACHE_ENABLED=true
CACHE_EXTERNAL_ANSWER_TTL=1800
REDIS_URL=redis://redis:6379/0

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
# Leave DATABASE_URL empty to use the Compose PostgreSQL service. Set only to
# point at an external pgvector-compatible database instead.
DATABASE_URL=
DB_HOST=postgres
DB_NAME=demo_firm
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=prefer
DB_USER=demo_firm_agent

# ── Document processing and local storage ────────────────────────────────────
DOCUMENT_STORAGE_PATH=/data/documents
OCR_ENABLED=true
OCR_LANGUAGE=por

# ── External legal research ──────────────────────────────────────────────────
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_MAX_MOVEMENTS=12
DATAJUD_MAX_PROCESSES=3
DATAJUD_TIMEOUT_SECONDS=60
# Search the Diario da Justica of the court DataJud identified for that process's
# publications (Serper first, Exa when Serper finds nothing). The one place a
# process number reaches a search engine: only a confirmed number, in quotes.
DJE_SEARCH_ENABLED=true
# Publications of a process in the CNJ's national diary (DJEN), read by process
# number. Same authority as DataJud, so no exception to where a number may go.
DJEN_ENABLED=true
EXA_API_KEY=
SERPER_ALLOWED_DOMAINS=jus.br,gov.br,leg.br,mp.br,def.br,oab.org.br
SERPER_API_KEY=
SERPER_MAX_QUERIES=3
SERPER_MAX_RESULTS=8
SERPER_SEARCH_URL=https://google.serper.dev/search
SERPER_TIMEOUT_SECONDS=30
# Which service finds candidate official pages. "serper" is the default; "exa"
# is the alternative kept behind this flag until a benchmark justifies a swap.
# Both obey the same SERPER_ALLOWED_DOMAINS allowlist, and either way the page
# reader still confirms the content and DataJud stays authoritative for a
# process number.
WEB_SEARCH_PROVIDER=serper

# ── Grafana and metrics ───────────────────────────────────────────────────────
# Operational metrics. Keep /metrics private at the reverse proxy.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
# The role Grafana uses to read the application's own database, for the
# questions metrics cannot answer: documents ingested per month, who requested
# access, which lawyer asks the most. Create it once with
# infra/sql/grafana_readonly.sql; it can only read, and only named columns.
GRAFANA_DB_PASSWORD=
GRAFANA_DB_USER=grafana_ro
METRICS_ENABLED=true

# ── Hosts: Telegram webhook, web pages, Traefik ──────────────────────────────
LEGAL_AGENT_HOST=
LEGAL_TELEGRAM_BOT_TOKEN=
# The pages' address (/web, /pje), on a host of its own. Links from the bot
# point here; leave WEB_BASE_URL empty to use PUBLIC_BASE_URL on one host.
# Changing these moves the pages and never the bot.
LEGAL_WEB_HOST=
# The webhook's address. set_webhook points Telegram here, and this host
# routes only /telegram/webhook and /health.
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
TRAEFIK_NETWORK=edge
WEB_BASE_URL=
# The web pages. Off until WEB_TOTP_KEY is set and the firm is ready: the bot
# answers /web with "not switched on" while WEB_ENABLED is false. The key
# seals the authenticator secrets, so losing it means everybody enrols again
# (/mfa refazer), and it belongs in the same safe place as DOC_MASTER_KEY.
# Generate on the server, straight into the file, never printed:
#   python3 -c "from cryptography.fernet import Fernet; print('WEB_TOTP_KEY=' + Fernet.generate_key().decode())" >> .env
# Needs WEB_BASE_URL (or PUBLIC_BASE_URL), where the login link points.
WEB_ENABLED=false
WEB_TOTP_KEY=
# The document explorer at /web/explorar/: off, pilot (only the staff ids in
# WEB_EXPLORER_STAFF, comma-separated) or on. Off, its pages do not exist.
WEB_EXPLORER=off
WEB_EXPLORER_STAFF=
# The assistant in the panel (/web/assistente/), switched the same way:
# off, pilot (only the ids in WEB_ASSISTANT_STAFF) or on.
WEB_ASSISTANT=off
WEB_ASSISTANT_STAFF=

# ── Inbox — a folder inside the object-storage bucket below ─────────────────
# The folder the firm drops documents into, read by /importar. It is a prefix
# of a Magalu Cloud bucket, read with the MGC_* key: the documents
# bucket unless INBOX_BUCKET names another, never the backups bucket. The
# encrypted originals live at that bucket's root, so the prefix cannot be empty
# there.
INBOX_BUCKET=
INBOX_ENABLED=false
INBOX_MAX_FILES_PER_RUN=25
INBOX_PREFIX=entrada/
# Read the bucket on a schedule instead of waiting for /importar. Office hours
# only, and it says nothing on a run that found nothing.
INBOX_SWEEP_ENABLED=false
INBOX_SWEEP_MINUTES=30

# ── LangSmith tracing (opt-in) ────────────────────────────────────────────────
# Legal content stays hidden unless both flags are deliberately changed after a
# privacy review.
LANGSMITH_API_KEY=
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_PROJECT=legal-ai-agent
LANGSMITH_TRACING=false

# ── LLM models and providers ──────────────────────────────────────────────────
# Prose reaches the bot's reads (deadline, documents, details, lawsuit,
# holidays) through the router. Off until clients/demo_firm/eval_conversation.py
# passes against the real model.
CONVERSATIONAL_ACTIONS=false
DRAFTING_MODEL=
EMBED_DIM=1536
EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=
LEGAL_MODEL=
LLM_COMPLEX_MODEL=gpt-4o
LLM_COMPLEX_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_SIMPLE_MODEL=gpt-4o-mini
LLM_SIMPLE_PROVIDER=openai
LLM_TEMPERATURE_COMPLEX=0.2
LLM_TEMPERATURE_SIMPLE=0.2
OPENAI_API_KEY=
RESEARCH_MODEL=
REVIEW_MODEL=
ROUTER_MODEL=

# ── Microsoft 365 ──────────────────────────────────────────────────────────────
# Connecting a lawyer's own Microsoft account (device code flow: the agent
# shows a code, the person signs in at microsoft.com/devicelogin, and the
# password never reaches this server).
#
# ONE app registration serves everybody: MS_CLIENT_ID identifies the agent,
# not the person, and is not a secret. What is per person is the token, stored
# encrypted, one row per staff member. Nobody registers their own app.
#
# The registration needs two things, and both are where this silently fails:
#
#   Supported account types: "Accounts in any organizational directory
#   (any Microsoft Entra ID tenant - Multitenant) and personal Microsoft
#   accounts". The firm's people are on unrelated accounts, some personal and
#   some corporate from different organisations, so a registration limited to
#   one tenant, or to personal accounts only, turns away half of them at the
#   sign-in screen.
#
#   Authentication -> Advanced settings -> "Allow public client flows": on.
#   Device code fails with a confusing error when this is off, and it is the
#   step most often missed.
#
# The Application (client) ID, "ID do aplicativo (cliente)" in the Portuguese
# portal. Not the tenant id ("ID do Locatário").
MS_CLIENT_ID=
MS_ENABLED=true
# "common" accepts both personal and organisational accounts and is the right
# value for unrelated accounts. "organizations" or a tenant id would only be
# right if the firm ever consolidates into one Microsoft 365 tenant.
MS_TENANT=common
# Encrypts the stored refresh tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every lawyer runs /microsoft again; leaking it plus a
# backup means somebody else can read their OneDrive.
MS_TOKEN_KEY=

# ── Object storage — BUCKET: Magalu Cloud, br-se1 ───────────────────────────
# Originals. With all five MGC_* below set, plus DOC_MASTER_KEY, new
# documents go to the bucket encrypted; without them they stay in
# DOCUMENT_STORAGE_PATH. The endpoint follows the bucket's region: check it
# with `mgc object-storage buckets list --region br-se1`.
#
# Named MGC_*, not OBJECT_STORE_*: there is a second provider in this project
# (Backblaze B2, for backups), and a generic name on one of two providers is
# exactly the kind of thing a tired edit points at the wrong one. B2's own
# credentials never live in .env; they live only in rclone.conf on the VPS.
DOC_MASTER_KEY=
MGC_ACCESS_KEY_ID=
MGC_BUCKET=
MGC_ENDPOINT=https://br-se1.magaluobjects.com
MGC_REGION=br-se1
# The rclone remote the backup reads the bucket originals through, named
# after the bucket: mgc:<MGC_BUCKET>. scripts/backup.sh refuses to run when
# the bucket is set and this is not, or when they name different buckets.
MGC_REMOTE=
MGC_SECRET_ACCESS_KEY=

# ── Office hours ────────────────────────────────────────────────────────────
OFFICE_END_HOUR=20
OFFICE_END_MINUTE=1
OFFICE_START_HOUR=8
OFFICE_START_MINUTE=0
OFFICE_TIMEZONE=America/Sao_Paulo
