          "rawSql": "SELECT date_trunc('day', created_at) AS \"time\",\n       action AS \"metric\",\n       count(*) AS \"value\"\nFROM document_access_log\nWHERE created_at > now() - interval '90 days'\nGROUP BY 1, 2 ORDER BY 1;",
