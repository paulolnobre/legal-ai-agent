          "rawQuery": true,
          "rawSql": "SELECT l.created_at AS \"quando\",\n       COALESCE(s.name, '-') AS \"pessoa\",\n       l.action AS \"ação\",\n       COALESCE(l.document_ids::text, '-') AS \"documentos\",\n       left(COALESCE(l.query, '-'), 120) AS \"pedido\"\nFROM document_access_log l\nLEFT JOIN staff s ON s.id = l.staff_id\nORDER BY l.created_at DESC\nLIMIT 100;",
          "refId": "A"
