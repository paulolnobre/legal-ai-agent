        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.id AS \"id\",\n       d.title AS \"título\",\n       COALESCE(d.doc_type, '-') AS \"tipo\",\n       COALESCE(d.matter, '-') AS \"caso\",\n       count(c.document_id) AS \"trechos\",\n       d.source_size_bytes AS \"bytes\",\n       d.created_at AS \"ingerido em\"\nFROM documents d\nLEFT JOIN document_chunks c ON c.document_id = d.id\nGROUP BY d.id, d.title, d.doc_type, d.matter, d.source_size_bytes, d.created_at\nORDER BY d.created_at DESC;",
          "refId": "A"
        }
      ],
      "title": "O acervo, por documento",
      "type": "table"
