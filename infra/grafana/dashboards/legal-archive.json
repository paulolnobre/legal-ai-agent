          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(s.name, 'desconhecido') AS \"pessoa\",\n       s.role AS \"papel\",\n       count(*) AS \"ações\",\n       max(l.created_at) AS \"última vez\"\nFROM document_access_log l\nLEFT JOIN staff s ON s.id = l.staff_id\nWHERE l.created_at > now() - interval '90 days'\nGROUP BY 1, 2 ORDER BY 3 DESC;",
          "refId": "A"
        }
      ],
