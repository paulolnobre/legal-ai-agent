{
  "uid": "demo-firm-costs",
  "title": "Costs (private)",
  "tags": [
    "costs"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now/M",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "gpt4o_in",
        "label": "gpt-4o in $/1M",
        "query": "2.50",
        "current": {
          "text": "2.50",
          "value": "2.50"
        },
        "options": [
          {
            "selected": true,
            "text": "2.50",
            "value": "2.50"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "gpt4o_out",
        "label": "gpt-4o out $/1M",
        "query": "10.00",
        "current": {
          "text": "10.00",
          "value": "10.00"
        },
        "options": [
          {
            "selected": true,
            "text": "10.00",
            "value": "10.00"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "mini_in",
        "label": "gpt-4o-mini in $/1M",
        "query": "0.15",
        "current": {
          "text": "0.15",
          "value": "0.15"
        },
        "options": [
          {
            "selected": true,
            "text": "0.15",
            "value": "0.15"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "mini_out",
        "label": "gpt-4o-mini out $/1M",
        "query": "0.60",
        "current": {
          "text": "0.60",
          "value": "0.60"
        },
        "options": [
          {
            "selected": true,
            "text": "0.60",
            "value": "0.60"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "whisper_min",
        "label": "Whisper $/min",
        "query": "0.006",
        "current": {
          "text": "0.006",
          "value": "0.006"
        },
        "options": [
          {
            "selected": true,
            "text": "0.006",
            "value": "0.006"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "serper_1k",
        "label": "Serper $/1k searches",
        "query": "1.00",
        "current": {
          "text": "1.00",
          "value": "1.00"
        },
        "options": [
          {
            "selected": true,
            "text": "1.00",
            "value": "1.00"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "vps_month",
        "label": "VPS $/month (Hostinger)",
        "query": "10",
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "selected": true,
            "text": "10",
            "value": "10"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "magalu_gb",
        "label": "Magalu bucket GB",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        },
        "options": [
          {
            "selected": true,
            "text": "0",
            "value": "0"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "magalu_gb_price",
        "label": "Magalu $/GB-month",
        "query": "0.02",
        "current": {
          "text": "0.02",
          "value": "0.02"
        },
        "options": [
          {
            "selected": true,
            "text": "0.02",
            "value": "0.02"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "b2_gb",
        "label": "Backblaze B2 GB",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        },
        "options": [
          {
            "selected": true,
            "text": "0",
            "value": "0"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "b2_gb_price",
        "label": "B2 $/GB-month",
        "query": "0.006",
        "current": {
          "text": "0.006",
          "value": "0.006"
        },
        "options": [
          {
            "selected": true,
            "text": "0.006",
            "value": "0.006"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Models (LLM)",
      "description": "Tokens in the selected range at the prices in the boxes above. Counted from the app's own meter, so it starts when the counter first reported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "(sum(increase(legal_llm_tokens_total{model=~\"gpt-4o(-20.*)?\",direction=\"input\"}[$__range])) or vector(0)) * $gpt4o_in / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o(-20.*)?\",direction=\"output\"}[$__range])) or vector(0)) * $gpt4o_out / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o-mini.*\",direction=\"input\"}[$__range])) or vector(0)) * $mini_in / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o-mini.*\",direction=\"output\"}[$__range])) or vector(0)) * $mini_out / 1e6",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Transcription",
      "description": "Audio seconds sent to Whisper (app and Telegram), in minutes, times the Whisper price.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "(sum(increase(legal_audio_seconds_total[$__range])) or vector(0)) / 60 * $whisper_min",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Web search",
      "description": "Serper calls in the range, errors included (a failed call may still be billed).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "(sum(increase(legal_external_calls_total{dependency=\"serper\"}[$__range])) or vector(0)) / 1000 * $serper_1k",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fixed per month",
      "description": "VPS plus bucket storage. Not prorated to the range: it is the monthly bill.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "$vps_month + $magalu_gb * $magalu_gb_price + $b2_gb * $b2_gb_price",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total",
      "description": "Variable cost in the range plus one month of fixed cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "((sum(increase(legal_llm_tokens_total{model=~\"gpt-4o(-20.*)?\",direction=\"input\"}[$__range])) or vector(0)) * $gpt4o_in / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o(-20.*)?\",direction=\"output\"}[$__range])) or vector(0)) * $gpt4o_out / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o-mini.*\",direction=\"input\"}[$__range])) or vector(0)) * $mini_in / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o-mini.*\",direction=\"output\"}[$__range])) or vector(0)) * $mini_out / 1e6) + ((sum(increase(legal_audio_seconds_total[$__range])) or vector(0)) / 60 * $whisper_min) + ((sum(increase(legal_external_calls_total{dependency=\"serper\"}[$__range])) or vector(0)) / 1000 * $serper_1k) + ($vps_month + $magalu_gb * $magalu_gb_price + $b2_gb * $b2_gb_price)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model cost per day",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(increase(legal_llm_tokens_total{model=~\"gpt-4o(-20.*)?\",direction=\"input\"}[1d])) or vector(0)) * $gpt4o_in / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o(-20.*)?\",direction=\"output\"}[1d])) or vector(0)) * $gpt4o_out / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o-mini.*\",direction=\"input\"}[1d])) or vector(0)) * $mini_in / 1e6 + (sum(increase(legal_llm_tokens_total{model=~\"gpt-4o-mini.*\",direction=\"output\"}[1d])) or vector(0)) * $mini_out / 1e6",
          "interval": "1d",
          "legendFormat": "models",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Tokens by model (in the range)",
      "description": "A model with no price in the boxes above shows here and is NOT in the cost. Add its price or tell me.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "sum by (model, direction) (increase(legal_llm_tokens_total[$__range]))",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Month by month, worst case (kept in the database)",
      "description": "Upper bound: every token priced at the dearer model's rate (BUDGET_PRICE_*). Older than the 180 days Prometheus keeps.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_ceiling_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT month, input_tokens, output_tokens, cost_ceiling_usd FROM budget_history ORDER BY month DESC LIMIT 12"
        }
      ]
    },
    {
      "id": 9,
      "type": "text",
      "title": "Reading this",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "options": {
        "mode": "markdown",
        "content": "All figures in US$ at public list prices; change any price in the boxes at the top (kept for this browser session; edit the dashboard file to change the defaults).\n\n- **Models, transcription, search** come from the app's own counters and follow the time range (default: this month so far).\n- **Fixed** is the monthly bill, not prorated. VPS and storage prices are estimates, and the storage sizes start at 0 GB: set them.\n- Not counted: embeddings (tiny), Exa searches, Telegram, the domain, and any tax or exchange-rate fee."
      }
    }
  ]
}
